<!DOCTYPE html>
<html lang="en">
<head>
    <title>MK_CareHub - Login</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/stylesheets/auth.css" />
</head>
<body>

    <%- include('partials/navbar') %>

    <main class="auth-container">
        <div class="auth-card">
        <h2>Welcome Back</h2>
        <p class="auth-subtitle">Login to continue</p>

        <form id="login-form">
            <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required />
            </div>

            <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required />
            </div>

            <p id="error-message" class="error-message"></p>

            <button type="submit" class="btn btn-primary btn-full">Login</button>
        </form>

        <p class="auth-switch">Don't have an account? <a href="/register">Register</a></p>
        <p class="auth-switch"><a href="/verifier-login">Login as Verifier</a></p>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/javascripts/api.js"></script>
    <script src="/javascripts/navbar.js"></script>
    <script src="/javascripts/login.js"></script>
</body>
</html>