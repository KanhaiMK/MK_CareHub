<!DOCTYPE html>
<html lang="en">
<head>
    <title>MK_CareHub - Verifier Dashboard</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/stylesheets/profile.css" />
    <link rel="stylesheet" href="/stylesheets/verifier.css" />
</head>
<body>

    <nav class="navbar">
        <a href="/verifier-dashboard" class="navbar-brand">
            <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="30" height="30">
            <path d="M12 21s-7.5-4.6-10-9.3C.4 8.4 2 4.8 5.5 4.1 8 3.6 10 5 12 7c2-2 4-3.4 6.5-2.9 3.5.7 5.1 4.3 3.5 7.6C19.5 16.4 12 21 12 21z" fill="var(--chestnut-rose)"/>
            <circle cx="12" cy="10.5" r="1.8" fill="var(--baby-blue)"/>
            <path d="M9.5 15c0-1.7 1.1-3 2.5-3s2.5 1.3 2.5 3" stroke="var(--baby-blue)" stroke-width="1.3" stroke-linecap="round" fill="none"/>
            </svg>
            <span>MK_Care<span class="brand-accent">Hub</span> <small>Verifier</small></span>
        </a>

        <button id="navbar-toggle" class="navbar-toggle" aria-label="Toggle menu">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>

        <div class="navbar-links" id="navbar-links">
            <button id="logout-btn" class="btn-link">Logout</button>
        </div>
    </nav>

    <main class="container">
        <h1>Verification Dashboard</h1>

        <div class="profile-tabs">
        <button class="tab-btn active" data-tab="children">Pending Children</button>
        <button class="tab-btn" data-tab="adoptions">Pending Adoptions</button>
        </div>

        <div id="tab-content" class="tab-content">
        <p class="loading-text">Loading...</p>
        </div>
    </main>

    <script src="/javascripts/api.js"></script>
    <script src="/javascripts/verifier-dashboard.js"></script>
</body>
</html>